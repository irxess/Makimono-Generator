				[0.998056, 1.266667, 1.416667, 1.533333, 1.633333, 1.716667, 1.766667, 1.833333, 1.883333, 1.916667, 1.95, 1.983333, 2.016667, 2.05, 2.083333, 2.116667, 2.133333, 2.166667, 2.183333, 2.2, 2.216667, 2.25, 2.266667, 2.283333, 2.3, 2.316667],
				[0.928, 1.162667, 1.312, 1.418667, 1.493333, 1.568, 1.621333, 1.674667, 1.717333, 1.749333, 1.792, 1.813333, 1.856, 1.877333, 1.909333, 1.930667, 1.952, 1.984, 1.994667, 2.005333, 2.026667, 2.058667, 2.058667, 2.08, 2.112, 2.122667],
