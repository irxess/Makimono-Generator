				1.05625, 1.077333, 1.1012, 1.12, 1.141333, 1.1575, 1.173333, 1.19,
				1.2, 1.2144, 1.229333, 1.24, 1.256, 1.2664, 1.267778, 1.276667, 1.29, 1.295
				]
			}
		}
	};

	const MINUTE = 60;
	const HOUR = MINUTE * 60;
	const MAX_DISPLAY_SECONDS = 100 * HOUR;

	const clamp = (value, min, max) => Math.min(Math.max(value, min), max);
	const lerp = (a, b, t) => a + (b - a) * t;

	/*
	Assumes `axis` is sorted ascending.
	Returns the index `i` such that:
	axis[i] <= value <= axis[i + 1]
	*/
	function segmentIndex(axis, value) {
		if (axis.length < 2) return 0;

		let low = 0;
		let high = axis.length - 1;

		while (high - low > 1) {
			const mid = (low + high) >> 1;
			if (axis[mid] <= value) low = mid;
			else high = mid;
		}

		return low;
	}

	function interpolate1(x, xs, ys) {
		const cx = clamp(x, xs[0], xs[xs.length - 1]);

		const i = segmentIndex(xs, cx);
		const j = Math.min(i + 1, xs.length - 1);

		const dx = xs[j] - xs[i];
		const weight = dx === 0 ? 0 : (cx - xs[i]) / dx;

		return lerp(ys[i], ys[j], weight);
	}

	function interpolate2(x, y, xs, ys, m) {
		const cx = clamp(x, xs[0], xs[xs.length - 1]);
		const cy = clamp(y, ys[0], ys[ys.length - 1]);

		const ix = segmentIndex(xs, cx);
		const iy = segmentIndex(ys, cy);

		const ix1 = Math.min(ix + 1, xs.length - 1);
		const iy1 = Math.min(iy + 1, ys.length - 1);

		const wx = xs[ix1] === xs[ix] ? 0 : (cx - xs[ix]) / (xs[ix1] - xs[ix]);
		const wy = ys[iy1] === ys[iy] ? 0 : (cy - ys[iy]) / (ys[iy1] - ys[iy]);

		const v00 = m[ix][iy];
		const v10 = m[ix1][iy];
		const v01 = m[ix][iy1];
		const v11 = m[ix1][iy1];

		const row0 = lerp(v00, v10, wx);
		const row1 = lerp(v01, v11, wx);

		return lerp(row0, row1, wy);
	}

	function makeEstimator(model) {
		const { type, h, dT, g } = model;

		if (type === "g1d") {
			return (thicknessMm, dTC) =>
			thicknessMm * thicknessMm * interpolate1(dTC, dT, g);
		}

		if (type === "g2d") {
			return (thicknessMm, dTC) =>
			thicknessMm * thicknessMm * interpolate2(thicknessMm, dTC, h, dT, g);
		}

		return null;
	}

	// Using Object.create(null) avoids prototype keys like "constructor" / "toString"
	const ESTIMATORS = Object.create(null);

	for (const [name, model] of Object.entries(BASELINE_MODEL.shapes)) {
		ESTIMATORS[name] = makeEstimator(model);
	}

	function parseInput(value) {
		const text = (value == null ? "" : String(value)).trim().replace(",", ".");
		if (text === "") return null;

		const number = Number(text);
		return Number.isFinite(number) ? number : null;
	}

	function formatTime(seconds) {
		if (!Number.isFinite(seconds) || seconds < 0) {
			return "Error: invalid time.";
		}

		if (seconds >= MAX_DISPLAY_SECONDS) {
			return "Error: too long time";
		}

		if (seconds < HOUR) {
			const minutes = Math.floor(seconds / MINUTE);
			const secs = Math.floor(seconds % MINUTE);
			return `${minutes} minutes ${secs} seconds`;
		}

		const hours = Math.floor(seconds / HOUR);
		const minutes = Math.floor((seconds % HOUR) / MINUTE);
		return `${hours} hours ${minutes} minutes`;
	}

	function formatTemperature(tempC) {
		return `${Math.round(tempC * 10) / 10} °C`;
	}

	function init() {
		const els = {
			shape: document.getElementById("shape-select"),
			thickness: document.getElementById("thickness"),
			start: document.getElementById("temp_starting"),
			final: document.getElementById("temp_final"),
			water: document.getElementById("water-bath-temperature"),
			result: document.getElementById("estimated-time-needed-result")
		};

		const setResult = (text) => {
			if (els.result instanceof HTMLInputElement) {
				els.result.value = text;
			} else {
				els.result.textContent = text;
			}
		};

		const update = () => {
			const shape = els.shape.value;
			const thickness = parseInput(els.thickness.value);
			const start = parseInput(els.start.value);
			const final = parseInput(els.final.value);
			const estimator = ESTIMATORS[shape];

			const valid =
			Boolean(estimator) &&
			Number.isFinite(thickness) && thickness > 0 &&
			Number.isFinite(start) &&
			Number.isFinite(final);

			if (!valid) {
				els.water.textContent = "-";
				setResult("Fill inn values for selected shape to get estimate.");
				return;
			}

			const dT = Math.abs(final - start);
			const seconds = dT === 0 ? 0 : estimator(thickness, dT);

			els.water.textContent = formatTemperature(final + 1);
			setResult(formatTime(seconds));
		};

		els.shape.addEventListener("change", update);
		[els.thickness, els.start, els.final].forEach((el) => el.addEventListener("input", update));

		window.UpdateEstimate = update;

		update();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", init);
	} else {
		init();
	}
</script>
{% endblock %}
{% block content %}
<section id="sous-vide-temps-main-section">
	<h1>Sous vide temperatures and times</h1>
	<section id="sous-vide-temps-intro-section">
		Here is a collection of usefull info and helpers for cooking sous vide.
	</section>
	<section id="sous-vide-temps-time-estimation-section">
		<h2>Time to core temp calculator</h2>
		<details>
			<summary>Notes</summary>
			<details>
				<summary>About</summary>
				<p>This is a tool for estimating the time needed for a food to reach your desired core temperature when cooking sous vide. It is based on the prescribed estimates found in The Modernist Cuisine (first edition) volume 2 page 276 - 279. As such, it is a very rough tool, but usefull to me in that it can answer questions like "If I want to sous vide a big fat roast for the weekend, should I start the day before, or how much time should I at least set aside on the day?" or "How long before the dinner do I need to start the neck chops?".</p>
			</details>
			<details>
				<summary>How to use</summary>
				<p>Fill in the approximate shape of the food you wish to sous vide, its thickness, the temperature of the food before you start cooking it, and your desired core temperature.</p>
				<p>Note that the estimate is based on the water bath being 1 ℃ above the desired core temperature. If you want to leave what you're cooking for a long time unattended this could affect the temperature you want to use, and thereby also the time needed.</p>
				<details>
					<summary>Shapes</summary>
					<p class="shape-description">
						<span class="shape-description-name">Flat slab</span>:
						Use this shape if the food is best described as a large lump/sphere/doesn't fit any of the other descriptions.
					</p>
					<p class="shape-description">
						<span class="shape-description-name">Spherical</span>:
						Use this shape if the food is best described as a large lump/sphere/doesn't fit any of the other descriptions.
					</p>
					<p class="shape-description">
						<span class="shape-description-name">Sausage</span>:
						Use this shape if the food is shaped like a long sausage/tenderloin. Should works best if it's at least 150mm long.
					</p>
					<p class="shape-description">
						<span class="shape-description-name">Hamburger</span>:
						Use this shape if the food is approximately a hamburger having 150mm diameter or less. For larger pieces use the slab shape.
					</p>
				</details>
			</details>
		</details>
		<form id="sous-vide-temps-time-estimation-form">
			<fieldset>
				<legend>Parameters</legend>
				<label for="shape-select">Food shape</label>
				<select id="shape-select" oninput="UpdateEstimate()">
					<option value="slab">Flat slab</option>
					<option value="spherical">Spherical</option>
					<option value="sausage">Sausage</option>
					<option value="hamburger">Hamburger</option>
				</select>
				<br>
				<label for="thickness">Thickness mm</label>
				<input
				id="thickness"
				type="number"
				min="1"
				step="any"
				style="width: 5em"
				oninput="UpdateEstimate()" />
				<br>
				<label for="temp_starting">Starting temperature ℃</label>
				<input
				id="temp_starting"
				type="number"
				min="-273.15"
				step="any"
				style="width: 5em"
				oninput="UpdateEstimate()" />
				<br>
				<label for="temp_final">Target core temperature ℃</label>
				<input
				id="temp_final"
				type="number"
				min="-273.15"
				step="any"
				style="width: 5em"
				oninput="UpdateEstimate()" />
				<!-- <fieldset>
					<legend>Temperature</legend>
				</fieldset> -->
			</fieldset>
			<fieldset>
				<legend>Result</legend>
				<label for="estimated-time-needed-result">Estimated time needed if water bath set to <span id="water-bath-temperature">-</span> ℃: </label>
				<br>
				<output
				id="estimated-time-needed-result"
				for="shape-select thickness temp_starting temp_final"
				form="sous-vide-temps-time-estimation-section"
				name="Estimated time needed"
				>Fill inn values for selected shape to get estimate.</output>
			</fieldset>
		</form>
	</section>
	<section id="sous-vide-timing-and-temperatures-section">
		<h2>Overview of core temperatures and sous vide cooking times</h2>
		<p>Here are a few tables of sous vide cooking temperatures and times for some foods. I found it annoying to look up at varius places all the time, so here is a compilation.</p>
