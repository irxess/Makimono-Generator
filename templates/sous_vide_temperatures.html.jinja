	#content {
		padding-left: 0.75em;
		padding-right: 0.75em;
	}
	/* End General styling for page */
	/* Begin Time calculator styling */
	#sous-vide-temps-time-estimation-section details {
		padding-left: 0.5em;
		background: #c4e89c;
		border: 1px solid #558b2f;
		margin: 0.5em;
		padding-top: 0.5em;
		padding-bottom: 0.25em;
	}
