				[0.658667, 0.821333, 0.92, 0.989333, 1.048, 1.093333, 1.133333, 1.168, 1.197333, 1.224, 1.248, 1.269333, 1.288, 1.309333, 1.322667, 1.357333, 1.357333, 1.373333, 1.389333, 1.408, 1.418667, 1.429333, 1.442667, 1.458667, 1.466667, 1.477333]
